        "requestCode": { "type": "string" },
        "assetName": { "type": "string" },
        "roomLocation": { "type": "string" },
        "status": { "type": "string", "enum": ["reported", "assigned", "in_repair", "completed"] }
      },
      "required": ["id", "requestCode", "assetName", "roomLocation", "status"]
    },
    "ClassPlacement": {
      "title": "ClassPlacement",
      "description": "Student class placement and transfer history across academic years",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentCode": { "type": "string" },
        "className": { "type": "string" },
        "academicYear": { "type": "string" },
        "placementType": { "type": "string" }
      },
      "required": ["id", "studentCode", "className", "academicYear"]
    },
    "TeachingAssignment": {
      "title": "TeachingAssignment",
      "description": "Teacher assignment to class and subject per academic year",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string", "maxLength": 100 },
        "className": { "type": "string" },
        "subject": { "type": "string" },
        "academicYear": { "type": "string" },
        "semester": { "type": "string" }
      },
      "required": ["id", "teacherName", "className", "subject", "academicYear"]
    },
    "ImportHistory": {
      "title": "ImportHistory",
      "description": "Excel and CSV bulk import audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "moduleKey": { "type": "string" },
        "fileName": { "type": "string" },
        "totalRows": { "type": "number" },
        "successCount": { "type": "number" },
        "failedCount": { "type": "number" },
        "actorName": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "moduleKey", "fileName", "timestamp"]
    },
    "ExportHistory": {
      "title": "ExportHistory",
