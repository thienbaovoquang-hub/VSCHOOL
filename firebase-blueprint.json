        "fileName": { "type": "string" },
        "actorName": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "moduleKey", "format", "fileName", "timestamp"]
    },
    "LibraryRenewalRequest": {
      "title": "LibraryRenewalRequest",
      "description": "Borrower renewal request requiring librarian approval",
