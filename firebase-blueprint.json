{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user account representation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "principal", "homeroom_teacher", "subject_teacher", "librarian", "counselor", "staff", "student"] },
        "preDevRole": { "type": "string", "enum": ["admin", "principal", "homeroom_teacher", "subject_teacher", "librarian", "counselor", "staff", "student"], "description": "Original role preserved before DEVELOPMENT_ADMIN_MODE temporary elevation" },
        "secondaryRoles": { "type": "array", "description": "Optional additional RBAC roles assigned to user (max 7)" },
        "status": { "type": "string", "enum": ["active", "locked", "disabled"] },
        "linkedProfileId": { "type": "string", "maxLength": 128 },
        "assignedClasses": { "type": "array" },
        "assignedSubjects": { "type": "array" },
        "permissionsOverride": { "type": "object" },
        "avatarUrl": { "type": "string", "maxLength": 2000 },
        "rfidCardId": { "type": "string", "maxLength": 64 },
        "studentCode": { "type": "string", "maxLength": 32 },
        "teacherCode": { "type": "string", "maxLength": 32 },
        "classId": { "type": "string", "maxLength": 128 },
        "className": { "type": "string", "maxLength": 64 },
        "grade": { "type": "number" },
        "phone": { "type": "string", "maxLength": 40 },
        "schoolId": { "type": "string", "maxLength": 64 },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "email", "displayName", "role"]
    },
    "AppRuntimeConfig": {
      "title": "AppRuntimeConfig",
      "description": "Server/Console-controlled runtime feature flag document (immutable from browser SDKs)",
      "type": "object",
      "properties": {
        "DEVELOPMENT_ADMIN_MODE": { "type": "boolean", "description": "When true, authenticated accounts default to active admin access during development" },
        "updatedAt": { "type": "string" }
      },
      "required": ["DEVELOPMENT_ADMIN_MODE"]
    },
    "UserInvite": {
      "title": "UserInvite",
      "description": "Email-indexed pre-provisioned user account invite for multi-account role binding on first Google Sign-In",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "emailLower": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "principal", "homeroom_teacher", "subject_teacher", "librarian", "counselor", "staff", "student"] },
        "secondaryRoles": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "locked", "disabled"] },
        "schoolId": { "type": "string", "maxLength": 64 },
        "claimedByUid": { "type": "string", "maxLength": 128 },
        "claimedAt": { "type": "string" }
      },
      "required": ["id", "email", "emailLower", "displayName", "role", "status"]
    },
    "ExternalDataset": {
      "title": "ExternalDataset",
      "description": "Shared cloud reference dataset imported into SchoolHub Analytics & AI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "schoolId": { "type": "string", "maxLength": 64 },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Student academic and identity profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentCode": { "type": "string", "maxLength": 32 },
        "fullName": { "type": "string", "maxLength": 100 },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "grade": { "type": "number" },
        "rfidCardId": { "type": "string" },
        "schoolId": { "type": "string", "maxLength": 64 },
        "version": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "studentCode", "fullName", "className", "grade"]
    },
    "TeacherProfile": {
      "title": "TeacherProfile",
      "description": "Teacher professional profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string" },
        "email": { "type": "string" },
        "isHomeroom": { "type": "boolean" },
        "status": { "type": "string" }
      },
      "required": ["id", "fullName", "subject"]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Administrative and support staff member",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "staffCode": { "type": "string" },
        "fullName": { "type": "string" },
        "department": { "type": "string" },
        "position": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "staffCode", "fullName", "department"]
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "High school class registry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "grade": { "type": "number" },
        "academicYear": { "type": "string" },
        "room": { "type": "string" }
      },
      "required": ["id", "code", "name", "grade"]
    },
    "TimetableEntry": {
      "title": "TimetableEntry",
      "description": "Class weekly schedule period slot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "dayOfWeek": { "type": "number" },
        "period": { "type": "number" },
        "subject": { "type": "string" },
        "teacherName": { "type": "string" },
        "room": { "type": "string" }
      },
      "required": ["id", "classId", "dayOfWeek", "period", "subject"]
    },
    "Book": {
      "title": "Book",
      "description": "Library book title metadata with Google Books and Open Library enrichment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookCode": { "type": "string" },
        "isbn": { "type": "string" },
        "isbn10": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "author": { "type": "string", "maxLength": 200 },
        "category": { "type": "string" },
        "publisher": { "type": "string" },
        "publishYear": { "type": "number" },
        "totalCopies": { "type": "number" },
        "availableCopies": { "type": "number" },
        "shelfLocation": { "type": "string" },
        "coverUrl": { "type": "string" },
        "description": { "type": "string" },
        "pageCount": { "type": "number" },
        "language": { "type": "string" },
        "subjects": { "type": "array" },
        "ratingsAverage": { "type": "number" },
        "ratingsCount": { "type": "number" },
        "googleBooksId": { "type": "string" },
        "openLibraryKey": { "type": "string" },
        "previewLink": { "type": "string" },
        "infoLink": { "type": "string" },
        "externalSource": { "type": "string", "enum": ["google_books", "open_library", "merged", "manual"] },
        "enrichedAt": { "type": "string" }
      },
      "required": ["id", "title", "author", "category"]
    },
    "BookCopy": {
      "title": "BookCopy",
      "description": "Physical copy of a library book with barcode/RFID",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookId": { "type": "string" },
        "copyBarcode": { "type": "string" },
        "rfidTag": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "borrowed", "reserved", "overdue", "damaged", "lost", "maintenance"] },
        "condition": { "type": "string" }
      },
      "required": ["id", "bookId", "copyBarcode", "status"]
    },
    "BorrowTransaction": {
      "title": "BorrowTransaction",
      "description": "Library loan transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "transactionCode": { "type": "string" },
        "studentId": { "type": "string" },
        "bookId": { "type": "string" },
        "copyBarcode": { "type": "string" },
        "borrowDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "status": { "type": "string", "enum": ["borrowed", "returned", "overdue", "lost"] }
      },
      "required": ["id", "transactionCode", "studentId", "bookId", "borrowDate", "dueDate", "status"]
    },
    "Survey": {
      "title": "Survey",
      "description": "School opinion survey form",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["active", "closed", "draft"] }
      },
      "required": ["id", "title", "status"]
    },
    "FeedbackReport": {
      "title": "FeedbackReport",
      "description": "Student suggestion, feedback or violation report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reportCode": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "reportCode", "title", "category", "content", "status"]
    },
    "CounselingRequest": {
      "title": "CounselingRequest",
      "description": "Confidential school counseling appointment booking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestCode": { "type": "string" },
        "type": { "type": "string", "enum": ["psychological", "academic", "career"] },
        "studentId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] }
      },
      "required": ["id", "requestCode", "type", "studentId", "status"]
    },
    "StudentLeaveRequest": {
      "title": "StudentLeaveRequest",
      "description": "Student leave or administrative request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestCode": { "type": "string" },
        "studentId": { "type": "string" },
        "className": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["id", "requestCode", "studentId", "status"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Technical and RFID helpdesk ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketCode": { "type": "string" },
        "title": { "type": "string" },
        "requesterId": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved", "closed"] }
      },
      "required": ["id", "ticketCode", "title", "requesterId", "status"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "School-wide and targeted announcement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string" },
        "publishedAt": { "type": "string" }
      },
      "required": ["id", "title", "content", "publishedAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Student daily attendance log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "classId": { "type": "string" },
        "studentId": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent_excused", "absent_unexcused", "late"] }
      },
      "required": ["id", "date", "classId", "studentId", "status"]
    },
    "AcademicRecord": {
      "title": "AcademicRecord",
      "description": "Student subject grade report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "subjectId": { "type": "string" },
        "semester": { "type": "string" },
        "averageScore": { "type": "number" }
      },
      "required": ["id", "studentId", "subjectId", "semester"]
    },
    "SchoolRoom": {
      "title": "SchoolRoom",
      "description": "Physical school classroom or lab registry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "code", "name", "status"]
    },
    "FacilityAsset": {
      "title": "FacilityAsset",
      "description": "School equipment and facility inventory asset",
