        "id": { "type": "string" },
        "transactionId": { "type": "string" },
        "actionType": { "type": "string", "enum": ["borrow", "return", "renew_approved", "due_date_edited", "marked_overdue"] },
        "changedBy": { "type": "string", "maxLength": 100 },
        "changedAt": { "type": "string" },
        "reason": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "transactionId", "actionType", "changedBy", "changedAt", "reason"]
    },
