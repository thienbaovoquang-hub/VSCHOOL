        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "roomLocation": { "type": "string" },
        "condition": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "code", "name", "roomLocation"]
    },
    "MaintenanceRequest": {
      "title": "MaintenanceRequest",
