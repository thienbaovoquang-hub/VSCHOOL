    match /competitions/{competitionId} {
      allow get: if isValidId(competitionId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(competitionId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.code, 1, 64) &&
        isValidString(request.resource.data.name, 1, 200) &&
        request.resource.data.transferMode in ['standalone', 'transfer_on_close', 'direct_sync', 'ratio_transfer'] &&
        request.resource.data.status in ['upcoming', 'ongoing', 'closed', 'archived'] &&
        isEducatorOrLeader() && incomingSameSchool();
      allow delete: if isValidId(competitionId) && isLeadership() && (resource == null || sameSchool(resource.data));
    }

    match /competitionCriteria/{criterionId} {
      allow get: if isValidId(criterionId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(criterionId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.competitionId, 1, 128) &&
        isValidString(request.resource.data.name, 1, 150) &&
        isValidNumberRange(request.resource.data.maxPoints, 0, 10000) &&
        isEducatorOrLeader() && incomingSameSchool();
      allow delete: if isValidId(criterionId) && isEducatorOrLeader() && (resource == null || sameSchool(resource.data));
    }

    match /competitionParticipants/{participantId} {
      allow get: if isValidId(participantId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(participantId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.competitionId, 1, 128) &&
        isValidString(request.resource.data.targetName, 1, 150) &&
        isEducatorOrLeader() && incomingSameSchool();
      allow delete: if isValidId(participantId) && isLeadership() && (resource == null || sameSchool(resource.data));
    }

    match /competitionScores/{scoreId} {
      allow get: if isValidId(scoreId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(scoreId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidNumberRange(request.resource.data.score, 0, 10000) &&
        isEducatorOrLeader() && incomingSameSchool();
      allow delete: if isValidId(scoreId) && isLeadership() && (resource == null || sameSchool(resource.data));
    }

    match /competitionAwards/{awardId} {
      allow get: if isValidId(awardId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(awardId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.competitionId, 1, 128) &&
        isValidString(request.resource.data.awardTitle, 1, 120) &&
        isValidNumberRange(request.resource.data.rank, 1, 1000) &&
        isEducatorOrLeader() && incomingSameSchool();
      allow delete: if isValidId(awardId) && isEducatorOrLeader() && (resource == null || sameSchool(resource.data));
    }

    match /scoreTransferRecords/{transferId} {
      allow get: if isValidId(transferId) && isEducatorOrLeader() && (resource == null || sameSchool(resource.data));
      allow list: if isEducatorOrLeader() && canListSchool();
      allow create: if isValidId(transferId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.sourceId, 1, 200) &&
        isValidString(request.resource.data.emulationRecordId, 1, 128) &&
        request.resource.data.syncStatus == 'synced' &&
        isLeadership() && incomingSameSchool();
      allow update: if isValidId(transferId) &&
        hasValidBaseMetadata(request.resource.data) &&
        request.resource.data.sourceId == resource.data.sourceId &&
        request.resource.data.syncStatus in ['synced', 'reverted'] &&
        isLeadership() && incomingSameSchool();
      allow delete: if false;
    }

    // Audit Logs, Import/Export History & System Settings
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isLeadership() && (resource == null || sameSchool(resource.data));
      allow list: if isLeadership() && canListSchool();
      allow create: if isValidId(logId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.action, 1, 200) &&
        isValidString(request.resource.data.actorName, 1, 120) &&
        isValidString(request.resource.data.target, 1, 500) &&
        isValidOptionalString(request.resource.data.get('detail', null), 2000) &&
        isUserActive() && incomingSameSchool();
      allow update, delete: if false;
    }

    match /importHistory/{historyId} {
      allow get: if isValidId(historyId) && isOperationsStaff() && (resource == null || sameSchool(resource.data));
      allow list: if isOperationsStaff() && canListSchool();
      allow create: if isValidId(historyId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.moduleKey, 1, 64) &&
        isValidString(request.resource.data.fileName, 1, 260) &&
        isOperationsStaff() && incomingSameSchool();
      allow update, delete: if false;
    }

    match /exportHistory/{historyId} {
      allow get: if isValidId(historyId) && isOperationsStaff() && (resource == null || sameSchool(resource.data));
      allow list: if isOperationsStaff() && canListSchool();
      allow create: if isValidId(historyId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.moduleKey, 1, 64) &&
        isValidString(request.resource.data.fileName, 1, 260) &&
        isOperationsStaff() && incomingSameSchool();
      allow update, delete: if false;
    }

    match /systemSettings/{settingId} {
      allow get: if isValidId(settingId) && isUserActive() && (settingId == 'global' || resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create: if isValidId(settingId) &&
        hasValidBaseMetadata(request.resource.data) &&
        incomingSameSchool() && (
          isAdmin() ||
          (isPrincipal() && !('customPermissions' in request.resource.data))
        );
      allow update: if isValidId(settingId) &&
        hasValidBaseMetadata(request.resource.data) &&
        incomingSameSchool() && (
          isAdmin() ||
          (isPrincipal() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customPermissions']))
        );
      allow delete: if false;
    }

    // Google Workspace Sync & Export Collections
    match /googleSyncSources/{sourceId} {
      allow get: if isValidId(sourceId) && isOperationsStaff() && (resource == null || sameSchool(resource.data));
      allow list: if isOperationsStaff() && canListSchool();
      allow create, update: if isValidId(sourceId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.fileId, 1, 200) &&
        isValidString(request.resource.data.fileName, 1, 260) &&
        request.resource.data.fileType in ['google_sheet', 'google_doc'] &&
        isValidString(request.resource.data.targetModule, 1, 64) &&
        request.resource.data.syncMode in ['realtime', 'scheduled', 'manual'] &&
        request.resource.data.syncDirection in ['sheets_to_schoolhub', 'schoolhub_to_sheets', 'bidirectional'] &&
        request.resource.data.paused is bool &&
        isLeadership() && incomingSameSchool();
      allow delete: if isValidId(sourceId) && isLeadership() && (resource == null || sameSchool(resource.data));
    }

    match /googleSyncHistory/{historyId} {
      allow get: if isValidId(historyId) && isOperationsStaff() && (resource == null || sameSchool(resource.data));
      allow list: if isOperationsStaff() && canListSchool();
      allow create: if isValidId(historyId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.sourceId, 1, 128) &&
        isValidString(request.resource.data.fileId, 1, 200) &&
        isValidString(request.resource.data.fileName, 1, 260) &&
        request.resource.data.fileType in ['google_sheet', 'google_doc'] &&
        request.resource.data.status in ['success', 'partial', 'failed', 'needs_approval'] &&
        isOperationsStaff() && incomingSameSchool();
      allow update, delete: if false;
    }

    match /googleDataChangeLogs/{logId} {
      allow get: if isValidId(logId) && isOperationsStaff() && (resource == null || sameSchool(resource.data));
      allow list: if isOperationsStaff() && canListSchool();
      allow create: if isValidId(logId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.sourceId, 1, 128) &&
        isValidString(request.resource.data.fileName, 1, 260) &&
        isValidString(request.resource.data.recordKey, 1, 200) &&
        isOperationsStaff() && incomingSameSchool();
      allow update, delete: if false;
    }

    match /googleSyncConflicts/{conflictId} {
      allow get: if isValidId(conflictId) && isLeadership() && (resource == null || sameSchool(resource.data));
      allow list: if isLeadership() && canListSchool();
      allow create, update: if isValidId(conflictId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.sourceId, 1, 128) &&
        isValidString(request.resource.data.recordKey, 1, 200) &&
        request.resource.data.status in ['pending', 'resolved_schoolhub', 'resolved_sheet', 'resolved_custom', 'ignored'] &&
        isLeadership() && incomingSameSchool();
      allow delete: if isValidId(conflictId) && isAdmin() && (resource == null || sameSchool(resource.data));
    }

    match /googlePendingDeletions/{deletionId} {
      allow get: if isValidId(deletionId) && isLeadership() && (resource == null || sameSchool(resource.data));
      allow list: if isLeadership() && canListSchool();
      allow create, update: if isValidId(deletionId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.sourceId, 1, 128) &&
        isValidString(request.resource.data.recordKey, 1, 200) &&
        request.resource.data.status in ['pending_review', 'kept_in_schoolhub', 'deleted'] &&
        isLeadership() && incomingSameSchool();
      allow delete: if isValidId(deletionId) && isAdmin() && (resource == null || sameSchool(resource.data));
    }

    match /googleDocProposals/{proposalId} {
      allow get: if isValidId(proposalId) && isEducatorOrLeader() && (resource == null || sameSchool(resource.data));
      allow list: if isEducatorOrLeader() && canListSchool();
      allow create, update: if isValidId(proposalId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.sourceId, 1, 128) &&
        isValidString(request.resource.data.fileId, 1, 200) &&
        isValidString(request.resource.data.fileName, 1, 260) &&
        request.resource.data.status in ['draft', 'approved', 'rejected'] &&
        isLeadership() && incomingSameSchool();
      allow delete: if isValidId(proposalId) && isAdmin() && (resource == null || sameSchool(resource.data));
    }

    match /googleReportTemplates/{templateId} {
      allow get: if isValidId(templateId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(templateId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.name, 1, 180) &&
        request.resource.data.fileType in ['google_sheet', 'google_doc'] &&
        isValidString(request.resource.data.targetScope, 1, 40) &&
        isLeadership() && incomingSameSchool();
      allow delete: if isValidId(templateId) && isLeadership() && (resource == null || sameSchool(resource.data));
    }

    // Per-module Unified Data Source Configurations (Excel OR Google Sheets per group; Admin-only write, no secret tokens)
    match /dataSourceConfigs/{configId} {
      allow get: if isValidId(configId) && isSchoolStaff() && (resource == null || sameSchool(resource.data));
      allow list: if isSchoolStaff() && canListSchool();
      allow create, update: if isValidId(configId) &&
        hasValidBaseMetadata(request.resource.data) &&
        request.resource.data.groupKey in ['students', 'staff', 'learning', 'books', 'facilities'] &&
        request.resource.data.activeMethod in ['excel', 'google_sheets'] &&
        isValidString(request.resource.data.sourceName, 1, 260) &&
        request.resource.data.syncMode in ['immediate', 'scheduled', 'manual'] &&
        request.resource.data.status in ['unconfigured', 'connected', 'syncing', 'synced', 'error', 'reauth_required'] &&
        !('accessToken' in request.resource.data) &&
        !('refreshToken' in request.resource.data) &&
        !('clientSecret' in request.resource.data) &&
        isAdmin() && incomingSameSchool();
      allow delete: if isValidId(configId) && isAdmin() && (resource == null || sameSchool(resource.data));
    }

    // Afternoon timetable & activity schedule
    match /afternoonSchedules/{entryId} {
      allow get: if isValidId(entryId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(entryId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidNumberRange(request.resource.data.dayOfWeek, 2, 7) &&
        isValidString(request.resource.data.startTime, 1, 20) &&
        isValidString(request.resource.data.endTime, 1, 20) &&
        isValidString(request.resource.data.activity, 1, 260) &&
        isEducatorOrLeader() && incomingSameSchool();
      allow delete: if isValidId(entryId) && isLeadership() && (resource == null || sameSchool(resource.data));
    }
  }
}
