rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.-]+$');
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isValidNumberRange(val, minVal, maxVal) {
      return (val is int || val is float) && val >= minVal && val <= maxVal;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return userDocExists() ? userDocData().role : 'student';
    }

    function isUserActive() {
      return !userDocExists() || userDocData().get('status', 'active') == 'active';
    }

    function hasRole(roleName) {
      return isSignedIn() && isUserActive() && (
        getUserRole() == roleName ||
        (userDocExists() && userDocData().get('secondaryRoles', []).hasAny([roleName]))
      );
    }

    function hasAnyRole(roles) {
      return isSignedIn() && isUserActive() && (
        getUserRole() in roles ||
        (userDocExists() && userDocData().get('secondaryRoles', []).hasAny(roles))
      );
    }

    function hasVerifiedEmail() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        'email' in request.auth.token &&
        request.auth.token.email is string;
    }

    function isPrimaryAdminEmail() {
      return hasVerifiedEmail() && (
        request.auth.token.email.lower() == 'thienbaovoquang@gmail.com' ||
        request.auth.token.email.lower() == 'nguyenvandung14102010@gmail.com' ||
        request.auth.token.email.lower() == 'nguyenvandung19112010@gmail.com' ||
        request.auth.token.email.lower() == 'nguyenvandunga3k30@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && isUserActive() && (
        isPrimaryAdminEmail() ||
        hasRole('admin')
      );
    }

    // Backend/Console-controlled Development Admin Mode flag (unmodifiable from browser/client SDKs).
    // Configure appConfig/runtime { DEVELOPMENT_ADMIN_MODE: false } via Firebase Console/Admin SDK or flip default below when launching RBAC production.
    function isDevelopmentAdminMode() {
      return exists(/databases/$(database)/documents/appConfig/runtime)
        ? get(/databases/$(database)/documents/appConfig/runtime).data.get('DEVELOPMENT_ADMIN_MODE', true) == true
        : true;
    }

    function isPrincipal() {
      return hasRole('principal');
    }

    function isTeacher() {
      return hasAnyRole(['homeroom_teacher', 'subject_teacher']);
    }

    function isHomeroomTeacher() {
      return hasRole('homeroom_teacher');
    }

    function isLibrarian() {
      return hasRole('librarian');
    }

    function isCounselor() {
      return hasRole('counselor');
    }

    function isFacilityStaff() {
      return hasRole('staff');
    }

    function isSchoolStaff() {
      return hasAnyRole(['admin', 'principal', 'homeroom_teacher', 'subject_teacher', 'librarian', 'counselor', 'staff']);
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserSchoolId() {
      return userDocExists() ? userDocData().get('schoolId', 'schoolhub_main') : 'schoolhub_main';
    }

    function isDefaultSchool() {
      return getUserSchoolId() == 'schoolhub_main';
    }

    function sameSchool(data) {
      return data == null || !('schoolId' in data) || data.schoolId == getUserSchoolId();
    }

    function canListSchool() {
      return isDefaultSchool() || resource.data.schoolId == getUserSchoolId();
    }

    function incomingSameSchool() {
      return !('schoolId' in request.resource.data) || request.resource.data.schoolId == getUserSchoolId();
    }

    function hasValidSchoolId(data) {
      return !('schoolId' in data) || (data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 64);
    }

    function hasValidVersion(data) {
      return !('version' in data) || (data.version is int && data.version >= 1 && data.version <= 1000000);
    }

    function expectedInviteId() {
      let rawId = 'INV_' + request.auth.token.email.lower().replace('[^a-z0-9._-]', '_');
      return rawId.size() > 128 ? rawId[0:128] : rawId;
    }

    function hasClaimableInvite() {
      return hasVerifiedEmail() &&
        exists(/databases/$(database)/documents/userInvites/$(expectedInviteId())) &&
        (get(/databases/$(database)/documents/userInvites/$(expectedInviteId())).data.get('claimedByUid', '') == '' ||
         get(/databases/$(database)/documents/userInvites/$(expectedInviteId())).data.get('claimedByUid', null) == null) &&
        get(/databases/$(database)/documents/userInvites/$(expectedInviteId())).data.get('emailLower', '') == request.auth.token.email.lower();
    }

    function claimableInviteData() {
      return get(/databases/$(database)/documents/userInvites/$(expectedInviteId())).data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Immutable runtime config (only readable by signed-in clients; never writable from browser SDKs)
    match /appConfig/{configId} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if false;
    }

    // Users collection (PII protected; role, secondaryRoles, schoolId & status cannot be escalated by self unless DEVELOPMENT_ADMIN_MODE is active)
    match /users/{userId} {
      allow get: if isUser(userId) || ((isAdmin() || isPrincipal() || isSchoolStaff()) && sameSchool(resource.data));
      allow list: if (isAdmin() || isPrincipal() || isSchoolStaff()) && canListSchool();
      allow create: if isValidId(userId) &&
        hasValidSchoolId(request.resource.data) &&
        hasValidVersion(request.resource.data) && (
          isAdmin() ||
          (isUser(userId) && isPrimaryAdminEmail() &&
            request.resource.data.role == 'admin' &&
            request.resource.data.get('status', 'active') == 'active' &&
            isValidString(request.resource.data.displayName, 1, 100)) ||
          (isUser(userId) && hasVerifiedEmail() && isDevelopmentAdminMode() &&
            request.resource.data.role == 'admin' &&
            request.resource.data.get('status', 'active') == 'active' &&
            isValidString(request.resource.data.displayName, 1, 100)) ||
          (isUser(userId) && hasClaimableInvite() &&
            request.resource.data.role == claimableInviteData().role &&
            request.resource.data.get('schoolId', 'schoolhub_main') == claimableInviteData().get('schoolId', 'schoolhub_main') &&
            request.resource.data.get('status', 'active') == claimableInviteData().get('status', 'active') &&
            isValidString(request.resource.data.displayName, 1, 100)) ||
          (isUser(userId) && hasVerifiedEmail() &&
            request.resource.data.role == 'student' &&
            request.resource.data.get('secondaryRoles', []).size() == 0 &&
            request.resource.data.get('status', 'active') == 'active' &&
            isValidString(request.resource.data.displayName, 1, 100))
        );
      allow update: if isValidId(userId) &&
        hasValidSchoolId(request.resource.data) &&
        hasValidVersion(request.resource.data) && (
          isAdmin() ||
          (isUser(userId) && isPrimaryAdminEmail() &&
            request.resource.data.role == 'admin' &&
            request.resource.data.get('status', 'active') == 'active') ||
          (isUser(userId) && hasVerifiedEmail() && isDevelopmentAdminMode() &&
            request.resource.data.role == 'admin' &&
            request.resource.data.get('status', 'active') == 'active' &&
            isValidString(request.resource.data.displayName, 1, 100)) ||
          (isUser(userId) && hasClaimableInvite() &&
            request.resource.data.role == claimableInviteData().role &&
            request.resource.data.get('schoolId', 'schoolhub_main') == claimableInviteData().get('schoolId', 'schoolhub_main') &&
            request.resource.data.get('status', 'active') == claimableInviteData().get('status', 'active')) ||
          (isUser(userId) && isUserActive() &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.get('schoolId', 'schoolhub_main') == resource.data.get('schoolId', 'schoolhub_main') &&
            request.resource.data.get('secondaryRoles', []) == resource.data.get('secondaryRoles', []) &&
            request.resource.data.get('status', 'active') == resource.data.get('status', 'active') &&
            isValidString(request.resource.data.displayName, 1, 100))
        );
      allow delete: if isValidId(userId) && isAdmin() && sameSchool(resource.data);
    }

    // Pre-provisioned account invites indexed by INV_<normalized_email>
    match /userInvites/{inviteId} {
      allow get: if isValidId(inviteId) && (
        ((isAdmin() || isPrincipal()) && sameSchool(resource.data)) ||
        (hasVerifiedEmail() && inviteId == expectedInviteId())
      );
      allow list: if (isAdmin() || isPrincipal()) && canListSchool();
      allow create: if isValidId(inviteId) && isAdmin() &&
        incomingSameSchool() &&
        hasValidSchoolId(request.resource.data) &&
        isValidString(request.resource.data.email, 3, 200) &&
        isValidString(request.resource.data.emailLower, 3, 200) &&
        isValidString(request.resource.data.displayName, 1, 100) &&
        request.resource.data.role in ['admin', 'principal', 'homeroom_teacher', 'subject_teacher', 'librarian', 'counselor', 'staff', 'student'] &&
        request.resource.data.status in ['active', 'locked', 'disabled'];
      allow update: if isValidId(inviteId) && hasValidSchoolId(request.resource.data) && (
        (isAdmin() && incomingSameSchool() &&
          isValidString(request.resource.data.email, 3, 200) &&
          isValidString(request.resource.data.displayName, 1, 100)) ||
        (hasVerifiedEmail() &&
          inviteId == expectedInviteId() &&
          resource.data.get('emailLower', '') == request.auth.token.email.lower() &&
          (resource.data.get('claimedByUid', '') == '' || resource.data.get('claimedByUid', null) == null) &&
          request.resource.data.claimedByUid == request.auth.uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.emailLower == resource.data.emailLower &&
          request.resource.data.get('schoolId', 'schoolhub_main') == resource.data.get('schoolId', 'schoolhub_main') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedByUid', 'claimedAt', 'updatedAt', 'updatedBy']))
      );
      allow delete: if isValidId(inviteId) && isAdmin() && sameSchool(resource.data);
    }

    // Shared cloud reference datasets for Analytics & AI
    match /externalDatasets/{datasetId} {
      allow get: if isSignedIn() && isUserActive() && sameSchool(resource.data);
      allow list: if isSignedIn() && isUserActive() && canListSchool();
      allow create, update: if isValidId(datasetId) &&
        (isAdmin() || isPrincipal() || isTeacher() || isLibrarian() || isFacilityStaff()) &&
        incomingSameSchool() &&
        hasValidSchoolId(request.resource.data) &&
        hasValidVersion(request.resource.data) &&
        isValidString(request.resource.data.title, 1, 200);
      allow delete: if isValidId(datasetId) && (isAdmin() || isPrincipal()) && sameSchool(resource.data);
    }

    // Student Profiles
    match /studentProfiles/{studentId} {
      allow get: if isSignedIn() && isUserActive() && sameSchool(resource.data) && (
        isAdmin() || isPrincipal() || isTeacher() || isLibrarian() || isCounselor() ||
        studentId == request.auth.uid || (resource != null && resource.data.id == request.auth.uid)
      );
      allow list: if isSignedIn() && isUserActive() && canListSchool() && (
        isAdmin() || isPrincipal() || isTeacher() || isLibrarian() || isCounselor() ||
        resource.data.id == request.auth.uid
      );
      allow create, update: if isValidId(studentId) && (isAdmin() || isPrincipal() || isHomeroomTeacher()) &&
        incomingSameSchool() &&
        isValidString(request.resource.data.studentCode, 2, 32) &&
        isValidString(request.resource.data.fullName, 1, 100);
      allow delete: if isAdmin() && sameSchool(resource.data);
    }

    // Teacher & Staff Profiles (teacherCode removed; identified by id/fullName/email)
    match /teacherProfiles/{teacherId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(teacherId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.fullName, 1, 100);
      allow delete: if isAdmin();
    }

    match /staffMembers/{staffId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(staffId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.fullName, 1, 100);
      allow delete: if isAdmin();
    }

    match /academicYears/{yearId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update, delete: if isValidId(yearId) && (isAdmin() || isPrincipal());
    }

    match /classes/{classId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(classId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.code, 1, 32) &&
        isValidString(request.resource.data.name, 1, 100);
      allow delete: if isAdmin();
    }

    match /timetable/{entryId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(entryId) && (isAdmin() || isPrincipal()) &&
        isValidNumberRange(request.resource.data.dayOfWeek, 2, 7) &&
        isValidNumberRange(request.resource.data.period, 1, 10) &&
        isValidString(request.resource.data.subject, 1, 100);
      allow delete: if isAdmin() || isPrincipal();
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(assignmentId) && (isAdmin() || isPrincipal() || isTeacher()) &&
        isValidString(request.resource.data.title, 1, 200);
      allow delete: if isAdmin() || isPrincipal() || isTeacher();
    }

    match /assignmentSubmissions/{submissionId} {
      allow read: if isSignedIn() && isUserActive() && (
        isAdmin() || isPrincipal() || isTeacher() || resource.data.studentId == request.auth.uid
      );
      allow create: if isValidId(submissionId) && isSignedIn() && isUserActive() &&
        request.resource.data.studentId == request.auth.uid &&
        isValidString(request.resource.data.content, 1, 4000);
      allow update: if isValidId(submissionId) && (isAdmin() || isPrincipal() || isTeacher());
      allow delete: if isAdmin();
    }

    match /learningMaterials/{materialId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(materialId) && (isAdmin() || isPrincipal() || isTeacher()) &&
        isValidString(request.resource.data.title, 1, 200);
      allow delete: if isAdmin() || isPrincipal() || isTeacher();
    }

    // Library catalog, physical copies, transactions, reservations, renewals, history & audits
    match /books/{bookId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(bookId) && (isAdmin() || isLibrarian()) &&
        isValidString(request.resource.data.title, 1, 200) &&
        isValidNumberRange(request.resource.data.totalCopies, 0, 10000) &&
        isValidNumberRange(request.resource.data.availableCopies, 0, 10000);
      allow delete: if isAdmin() || isLibrarian();
    }

    match /bookCopies/{copyId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(copyId) && (isAdmin() || isLibrarian()) &&
        isValidString(request.resource.data.bookId, 1, 128) &&
        isValidString(request.resource.data.copyBarcode, 1, 64);
      allow delete: if isAdmin() || isLibrarian();
    }

    match /borrowTransactions/{transactionId} {
      allow read: if isSignedIn() && isUserActive() && (
        isAdmin() || isPrincipal() || isLibrarian() || resource.data.studentId == request.auth.uid
      );
      allow create, update: if isValidId(transactionId) && (isAdmin() || isLibrarian()) &&
        isValidString(request.resource.data.studentId, 1, 128) &&
        isValidString(request.resource.data.bookId, 1, 128);
      allow delete: if isAdmin();
    }

    match /bookReservations/{reservationId} {
      allow read: if isSignedIn() && isUserActive() && (
        isAdmin() || isPrincipal() || isLibrarian() || resource.data.studentId == request.auth.uid
      );
      allow create: if isValidId(reservationId) && isSignedIn() && isUserActive() && (
        isAdmin() || isLibrarian() || request.resource.data.studentId == request.auth.uid
      );
      allow update: if isValidId(reservationId) && (
        isAdmin() || isLibrarian() || resource.data.studentId == request.auth.uid
      );
      allow delete: if isAdmin() || isLibrarian();
    }

    match /libraryRenewalRequests/{requestId} {
      allow read: if isSignedIn() && isUserActive() && (
        isAdmin() || isPrincipal() || isLibrarian() || resource.data.borrowerId == request.auth.uid
      );
      allow create: if isValidId(requestId) && isSignedIn() && isUserActive() &&
        isValidString(request.resource.data.transactionId, 1, 128) &&
        isValidString(request.resource.data.reason, 2, 1000) &&
        request.resource.data.status == 'pending' &&
        (isAdmin() || isLibrarian() || request.resource.data.borrowerId == request.auth.uid);
      allow update: if isValidId(requestId) && (isAdmin() || isLibrarian()) &&
        request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if isAdmin();
    }

    match /libraryTransactionHistory/{entryId} {
      allow read: if isSignedIn() && isUserActive() && (
        isAdmin() || isPrincipal() || isLibrarian()
      );
      allow create: if isValidId(entryId) && (isAdmin() || isLibrarian() || isPrincipal()) &&
        isValidString(request.resource.data.transactionId, 1, 128) &&
        isValidString(request.resource.data.reason, 2, 1000) &&
        request.resource.data.actionType in ['borrow', 'return', 'renew_approved', 'due_date_edited', 'marked_overdue'];
      allow update, delete: if false;
    }

    match /inventoryAudits/{auditId} {
      allow read: if isSignedIn() && isUserActive() && (isAdmin() || isPrincipal() || isLibrarian());
      allow create, update: if isValidId(auditId) && (isAdmin() || isLibrarian());
      allow delete: if isAdmin();
    }

    // Surveys & Responses
    match /surveys/{surveyId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(surveyId) && (isAdmin() || isPrincipal() || isTeacher() || isCounselor()) &&
        isValidString(request.resource.data.title, 1, 200);
      allow delete: if isAdmin();
    }

    match /surveyResponses/{responseId} {
      allow get: if isSignedIn() && isUserActive() && sameSchool(resource.data) && (
        isAdmin() || isPrincipal() || isCounselor() || (resource != null && resource.data.studentId == request.auth.uid)
      );
      allow list: if isSignedIn() && isUserActive() && canListSchool() && (
        isAdmin() || isPrincipal() || isCounselor() || resource.data.studentId == request.auth.uid
      );
      allow create: if isValidId(responseId) && isSignedIn() && isUserActive() &&
        incomingSameSchool() &&
        (request.resource.data.studentId == request.auth.uid || request.resource.data.studentId == 'ANONYMOUS');
      allow update, delete: if false;
    }

    // Feedback Reports
    match /feedbackReports/{reportId} {
      allow read: if isSignedIn() && isUserActive() && (
        isAdmin() || isPrincipal() || isFacilityStaff() || resource.data.studentId == request.auth.uid
      );
      allow create: if isValidId(reportId) && isSignedIn() && isUserActive() &&
        isValidString(request.resource.data.title, 1, 200) &&
        isValidString(request.resource.data.content, 1, 4000) &&
        (isAdmin() || isPrincipal() || request.resource.data.studentId == request.auth.uid || request.resource.data.isAnonymous == true);
      allow update: if isValidId(reportId) && (isAdmin() || isPrincipal() || isFacilityStaff());
      allow delete: if isAdmin();
    }

    // Counseling Requests - STRICTLY CONFIDENTIAL (Admin/Principal/Teachers have NO access unless explicitly holding counselor role)
    match /counselingRequests/{requestId} {
      allow read: if isSignedIn() && isUserActive() && (
        isCounselor() || resource.data.studentId == request.auth.uid
      );
      allow create: if isValidId(requestId) && isSignedIn() && isUserActive() &&
        request.resource.data.studentId == request.auth.uid &&
        isValidString(request.resource.data.topic, 1, 250);
      allow update: if isValidId(requestId) && isSignedIn() && isUserActive() && (
        isCounselor() ||
        (resource.data.studentId == request.auth.uid && request.resource.data.studentId == resource.data.studentId)
      );
      allow delete: if isCounselor() || (isSignedIn() && resource.data.studentId == request.auth.uid);
    }

    // Student Leave Requests & Technical Support Tickets
    match /leaveRequests/{requestId} {
      allow read: if isSignedIn() && isUserActive() && (
        isAdmin() || isPrincipal() || isHomeroomTeacher() || resource.data.studentId == request.auth.uid
      );
      allow create: if isValidId(requestId) && isSignedIn() && isUserActive() &&
        (isAdmin() || isPrincipal() || request.resource.data.studentId == request.auth.uid) &&
        isValidString(request.resource.data.reason, 1, 1000);
      allow update: if isValidId(requestId) && (isAdmin() || isPrincipal() || isHomeroomTeacher());
      allow delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && isUserActive() && (
        isAdmin() || isPrincipal() || isFacilityStaff() || resource.data.requesterId == request.auth.uid
      );
      allow create: if isValidId(ticketId) && isSignedIn() && isUserActive() &&
        request.resource.data.requesterId == request.auth.uid &&
        isValidString(request.resource.data.title, 1, 200);
      allow update: if isValidId(ticketId) && (isAdmin() || isPrincipal() || isFacilityStaff());
      allow delete: if isAdmin();
    }

    // Announcements & School Events
    match /announcements/{announcementId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(announcementId) && (isAdmin() || isPrincipal() || isTeacher() || isLibrarian()) &&
        isValidString(request.resource.data.title, 1, 200) &&
        isValidString(request.resource.data.content, 1, 8000);
      allow delete: if isAdmin() || isPrincipal();
    }

    match /schoolEvents/{eventId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(eventId) && isSignedIn() && isUserActive() && (
        isAdmin() || isPrincipal() || isTeacher() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredUserIds'])
      );
      allow delete: if isAdmin() || isPrincipal();
    }

    // Attendance Records
    match /attendanceRecords/{recordId} {
      allow read: if isSignedIn() && isUserActive() && (
        isAdmin() || isPrincipal() || isTeacher() || resource.data.studentId == request.auth.uid
      );
      allow create, update: if isValidId(recordId) && (isAdmin() || isPrincipal() || isTeacher()) &&
        request.resource.data.status in ['present', 'absent_excused', 'absent_unexcused', 'late'];
      allow delete: if isAdmin();
    }

    // Academic Records
    match /academicRecords/{recordId} {
      allow get: if isSignedIn() && isUserActive() && sameSchool(resource.data) && (
        isAdmin() || isPrincipal() || isTeacher() ||
        (resource != null && resource.data.studentId == request.auth.uid && resource.data.get('status', 'published') != 'draft')
      );
      allow list: if isSignedIn() && isUserActive() && canListSchool() && (
        isAdmin() || isPrincipal() || isTeacher() ||
        (resource.data.studentId == request.auth.uid && resource.data.status == 'published')
      );
      allow create, update: if isValidId(recordId) && (isAdmin() || isPrincipal() || isTeacher()) &&
        incomingSameSchool() &&
        isValidNumberRange(request.resource.data.scoreMidterm, 0, 10) &&
        isValidNumberRange(request.resource.data.scoreFinal, 0, 10) &&
        isValidNumberRange(request.resource.data.averageScore, 0, 10);
      allow delete: if isAdmin() && sameSchool(resource.data);
    }

    // Rooms, Facilities & Maintenance
    match /rooms/{roomId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(roomId) && (isAdmin() || isPrincipal() || isFacilityStaff()) &&
        isValidString(request.resource.data.code, 1, 32) &&
        isValidString(request.resource.data.name, 1, 100);
      allow delete: if isAdmin();
    }

    match /facilities/{assetId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(assetId) && (isAdmin() || isPrincipal() || isFacilityStaff()) &&
        isValidString(request.resource.data.name, 1, 150);
      allow delete: if isAdmin();
    }

    match /maintenanceRequests/{requestId} {
      allow read: if isSignedIn() && isUserActive();
      allow create: if isValidId(requestId) && isSignedIn() && isUserActive() &&
        isValidString(request.resource.data.assetName, 1, 150) &&
        isValidString(request.resource.data.roomLocation, 1, 100);
      allow update: if isValidId(requestId) && (isAdmin() || isPrincipal() || isFacilityStaff());
      allow delete: if isAdmin();
    }

    match /classPlacements/{placementId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(placementId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.studentCode, 2, 32) &&
        isValidString(request.resource.data.className, 1, 64) &&
        isValidString(request.resource.data.academicYear, 4, 32);
      allow delete: if isAdmin();
    }

    match /teachingAssignments/{assignmentId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(assignmentId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.teacherName, 1, 100) &&
        isValidString(request.resource.data.className, 1, 64) &&
        isValidString(request.resource.data.subject, 1, 100);
      allow delete: if isAdmin();
    }

    // Rules, Emulation, Appeals, Periods, Snapshots & Competitions
    match /ruleDocuments/{documentId} {
      allow read: if isSignedIn() && isUserActive();
      allow create: if isValidId(documentId) && (isAdmin() || isPrincipal() || isHomeroomTeacher()) &&
        isValidString(request.resource.data.title, 1, 200) &&
        isValidString(request.resource.data.fileName, 1, 260) &&
        request.resource.data.status in ['draft', 'approved', 'archived'];
      allow update: if isValidId(documentId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.title, 1, 200) &&
        request.resource.data.status in ['draft', 'approved', 'archived'];
      allow delete: if isAdmin() || isPrincipal();
    }

    match /ruleVersions/{versionId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(versionId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.title, 1, 200) &&
        request.resource.data.status in ['draft', 'approved', 'archived'];
      allow delete: if isAdmin();
    }

    match /ruleCategories/{categoryId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(categoryId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.code, 1, 64) &&
        isValidString(request.resource.data.name, 1, 120) &&
        request.resource.data.status in ['active', 'inactive'];
      allow delete: if isAdmin();
    }

    match /ruleCriteria/{criterionId} {
      allow read: if isSignedIn() && isUserActive();
      allow create: if isValidId(criterionId) && (isAdmin() || isPrincipal() || isHomeroomTeacher()) &&
        isValidString(request.resource.data.code, 1, 64) &&
        isValidString(request.resource.data.name, 1, 200) &&
        request.resource.data.type in ['violation', 'achievement'] &&
        request.resource.data.status in ['draft', 'active', 'inactive'];
      allow update: if isValidId(criterionId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.name, 1, 200) &&
        request.resource.data.status in ['draft', 'active', 'inactive'];
      allow delete: if isAdmin();
    }

    match /emulationRecords/{recordId} {
      allow get: if isSignedIn() && isUserActive() && sameSchool(resource.data) && (
        isSchoolStaff() || (resource != null && resource.data.studentId == request.auth.uid)
      );
      allow list: if isSignedIn() && isUserActive() && canListSchool() && (
        isSchoolStaff() || resource.data.studentId == request.auth.uid
      );
      allow create: if isValidId(recordId) && (isAdmin() || isPrincipal() || isTeacher() || isFacilityStaff()) &&
        isValidString(request.resource.data.recordCode, 1, 64) &&
        isValidString(request.resource.data.criterionId, 1, 128) &&
        request.resource.data.targetType in ['individual', 'class', 'group'] &&
        request.resource.data.type in ['violation', 'achievement'] &&
        isValidNumberRange(request.resource.data.pointsApplied, -1000, 1000) &&
        request.resource.data.status in ['draft', 'pending_verification', 'verified', 'pending_approval', 'recorded', 'insufficient_evidence', 'cancelled'];
      allow update: if isValidId(recordId) && (isAdmin() || isPrincipal() || isHomeroomTeacher()) &&
        isValidNumberRange(request.resource.data.pointsApplied, -1000, 1000) &&
        request.resource.data.status in ['draft', 'pending_verification', 'verified', 'pending_approval', 'recorded', 'insufficient_evidence', 'cancelled'];
      allow delete: if isAdmin();
    }

    match /emulationAppeals/{appealId} {
      allow read: if isSignedIn() && isUserActive() && (
        isAdmin() || isPrincipal() || isTeacher() || resource.data.studentId == request.auth.uid
      );
      allow create: if isValidId(appealId) && isSignedIn() && isUserActive() &&
        isValidString(request.resource.data.recordId, 1, 128) &&
        isValidString(request.resource.data.reason, 2, 2000) &&
        request.resource.data.status == 'submitted' &&
        (isAdmin() || isPrincipal() || request.resource.data.studentId == request.auth.uid);
      allow update: if isValidId(appealId) && (isAdmin() || isPrincipal() || isHomeroomTeacher()) &&
        request.resource.data.status in ['submitted', 'reviewing', 'need_info', 'accepted', 'rejected'];
      allow delete: if isAdmin();
    }

    match /emulationPeriods/{periodId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(periodId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.name, 1, 150) &&
        request.resource.data.status in ['open', 'closed', 'locked'];
      allow delete: if isAdmin();
    }

    match /emulationSnapshots/{snapshotId} {
      allow read: if isSignedIn() && isUserActive();
      allow create: if isValidId(snapshotId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.periodId, 1, 128) &&
        isValidString(request.resource.data.periodName, 1, 150);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /emulationTitleConfigs/{configId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update, delete: if isValidId(configId) && (isAdmin() || isPrincipal());
    }

    match /competitions/{competitionId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(competitionId) && (isAdmin() || isPrincipal() || isTeacher()) &&
        isValidString(request.resource.data.code, 1, 64) &&
        isValidString(request.resource.data.name, 1, 200) &&
        request.resource.data.transferMode in ['standalone', 'transfer_on_close', 'direct_sync', 'ratio_transfer'] &&
        request.resource.data.status in ['upcoming', 'ongoing', 'closed', 'archived'];
      allow delete: if isAdmin() || isPrincipal();
    }

    match /competitionCriteria/{criterionId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update, delete: if isValidId(criterionId) && (isAdmin() || isPrincipal() || isTeacher());
    }

    match /competitionParticipants/{participantId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(participantId) && (isAdmin() || isPrincipal() || isTeacher()) &&
        isValidString(request.resource.data.competitionId, 1, 128) &&
        isValidString(request.resource.data.targetName, 1, 150);
      allow delete: if isAdmin() || isPrincipal();
    }

    match /competitionScores/{scoreId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update: if isValidId(scoreId) && (isAdmin() || isPrincipal() || isTeacher()) &&
        isValidNumberRange(request.resource.data.score, 0, 10000);
      allow delete: if isAdmin() || isPrincipal();
    }

    match /competitionAwards/{awardId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update, delete: if isValidId(awardId) && (isAdmin() || isPrincipal() || isTeacher());
    }

    match /scoreTransferRecords/{transferId} {
      allow read: if isSignedIn() && isUserActive() && (isAdmin() || isPrincipal() || isTeacher());
      allow create: if isValidId(transferId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.sourceId, 1, 200) &&
        isValidString(request.resource.data.emulationRecordId, 1, 128) &&
        request.resource.data.syncStatus == 'synced';
      allow update: if isValidId(transferId) && (isAdmin() || isPrincipal()) &&
        request.resource.data.sourceId == resource.data.sourceId &&
        request.resource.data.syncStatus in ['synced', 'reverted'];
      allow delete: if false;
    }

    // Audit Logs, Import/Export History & System Settings
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isPrincipal();
      allow create: if isValidId(logId) && isSignedIn() && isUserActive();
      allow update, delete: if false;
    }

    match /importHistory/{historyId} {
      allow read: if isSignedIn() && isUserActive() && (isAdmin() || isPrincipal() || isLibrarian() || isTeacher() || isFacilityStaff());
      allow create: if isValidId(historyId) && isSignedIn() && isUserActive() &&
        (isAdmin() || isPrincipal() || isLibrarian() || isTeacher() || isFacilityStaff()) &&
        isValidString(request.resource.data.moduleKey, 1, 64) &&
        isValidString(request.resource.data.fileName, 1, 260);
      allow update, delete: if false;
    }

    match /exportHistory/{historyId} {
      allow read: if isSignedIn() && isUserActive() && (isAdmin() || isPrincipal() || isLibrarian() || isTeacher() || isFacilityStaff());
      allow create: if isValidId(historyId) && isSignedIn() && isUserActive() &&
        isValidString(request.resource.data.moduleKey, 1, 64) &&
        isValidString(request.resource.data.fileName, 1, 260);
      allow update, delete: if false;
    }

    match /systemSettings/{settingId} {
      allow read: if isSignedIn() && isUserActive();
      allow create: if isValidId(settingId) && (
        isAdmin() ||
        (isPrincipal() && !('customPermissions' in request.resource.data))
      );
      allow update: if isValidId(settingId) && (
        isAdmin() ||
        (isPrincipal() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customPermissions']))
      );
      allow delete: if false;
    }

    // Google Workspace Sync & Export Collections
    match /googleSyncSources/{sourceId} {
      allow read: if isSignedIn() && isUserActive() && (isAdmin() || isPrincipal() || isTeacher() || isLibrarian() || isFacilityStaff());
      allow create, update: if isValidId(sourceId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.fileId, 1, 200) &&
        isValidString(request.resource.data.fileName, 1, 260) &&
        request.resource.data.fileType in ['google_sheet', 'google_doc'] &&
        isValidString(request.resource.data.targetModule, 1, 64) &&
        request.resource.data.syncMode in ['realtime', 'scheduled', 'manual'] &&
        request.resource.data.syncDirection in ['sheets_to_schoolhub', 'schoolhub_to_sheets', 'bidirectional'] &&
        request.resource.data.paused is bool;
      allow delete: if isValidId(sourceId) && (isAdmin() || isPrincipal());
    }

    match /googleSyncHistory/{historyId} {
      allow read: if isSignedIn() && isUserActive() && (isAdmin() || isPrincipal() || isTeacher() || isLibrarian() || isFacilityStaff());
      allow create: if isValidId(historyId) && isSignedIn() && isUserActive() &&
        (isAdmin() || isPrincipal() || isTeacher() || isLibrarian() || isFacilityStaff()) &&
        isValidString(request.resource.data.sourceId, 1, 128) &&
        isValidString(request.resource.data.fileId, 1, 200) &&
        isValidString(request.resource.data.fileName, 1, 260) &&
        request.resource.data.fileType in ['google_sheet', 'google_doc'] &&
        request.resource.data.status in ['success', 'partial', 'failed', 'needs_approval'];
      allow update, delete: if false;
    }

    match /googleDataChangeLogs/{logId} {
      allow read: if isSignedIn() && isUserActive() && (isAdmin() || isPrincipal() || isTeacher() || isLibrarian());
      allow create: if isValidId(logId) && isSignedIn() && isUserActive() &&
        (isAdmin() || isPrincipal() || isTeacher() || isLibrarian() || isFacilityStaff()) &&
        isValidString(request.resource.data.sourceId, 1, 128) &&
        isValidString(request.resource.data.fileName, 1, 260) &&
        isValidString(request.resource.data.recordKey, 1, 200);
      allow update, delete: if false;
    }

    match /googleSyncConflicts/{conflictId} {
      allow read: if isSignedIn() && isUserActive() && (isAdmin() || isPrincipal());
      allow create, update: if isValidId(conflictId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.sourceId, 1, 128) &&
        isValidString(request.resource.data.recordKey, 1, 200) &&
        request.resource.data.status in ['pending', 'resolved_schoolhub', 'resolved_sheet', 'resolved_custom', 'ignored'];
      allow delete: if isAdmin();
    }

    match /googlePendingDeletions/{deletionId} {
      allow read: if isSignedIn() && isUserActive() && (isAdmin() || isPrincipal());
      allow create, update: if isValidId(deletionId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.sourceId, 1, 128) &&
        isValidString(request.resource.data.recordKey, 1, 200) &&
        request.resource.data.status in ['pending_review', 'kept_in_schoolhub', 'deleted'];
      allow delete: if isAdmin();
    }

    match /googleDocProposals/{proposalId} {
      allow read: if isSignedIn() && isUserActive() && (isAdmin() || isPrincipal() || isTeacher());
      allow create, update: if isValidId(proposalId) && (isAdmin() || isPrincipal()) &&
        isValidString(request.resource.data.sourceId, 1, 128) &&
        isValidString(request.resource.data.fileId, 1, 200) &&
        isValidString(request.resource.data.fileName, 1, 260) &&
        request.resource.data.status in ['draft', 'approved', 'rejected'];
      allow delete: if isAdmin();
    }

    match /googleReportTemplates/{templateId} {
      allow read: if isSignedIn() && isUserActive();
      allow create, update, delete: if isValidId(templateId) && (isAdmin() || isPrincipal());
    }
  }
}
