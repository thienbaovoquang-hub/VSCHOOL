rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Zero-Read Static Validators (Evaluate Before DB Lookups) =====
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.-]+$');
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isValidNumberRange(val, minVal, maxVal) {
      return (val is int || val is float) && val >= minVal && val <= maxVal;
    }

    function hasValidSchoolId(data) {
      return !('schoolId' in data) || (data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 64);
    }

    function hasValidVersion(data) {
      return !('version' in data) || (data.version is int && data.version >= 1 && data.version <= 1000000);
    }

    function hasValidBaseMetadata(data) {
      return hasValidSchoolId(data) && hasValidVersion(data);
    }

    function isValidRole(role) {
      return role in [
        'admin',
        'principal',
        'homeroom_teacher',
        'subject_teacher',
        'librarian',
        'counselor',
        'staff',
        'student'
      ];
    }

    function normalizedSchoolId(data) {
      return !('schoolId' in data) || data.schoolId == null || data.schoolId == ''
        ? 'schoolhub_main'
        : data.schoolId;
    }

    function normalizedStatus(data) {
      return !('status' in data) || data.status == null || data.status == ''
        ? 'active'
        : data.status;
    }

    function normalizedSecondaryRoles(data) {
      return !('secondaryRoles' in data) || data.secondaryRoles == null
        ? []
        : data.secondaryRoles;
    }

    function isValidUserPayload(data, userId) {
      return (!('id' in data) || data.id == userId) &&
        isValidString(data.displayName, 1, 100) &&
        isValidOptionalString(data.get('email', null), 200) &&
        isValidOptionalString(data.get('avatarUrl', null), 2000) &&
        isValidOptionalString(data.get('phone', null), 40) &&
        'role' in data &&
        isValidRole(data.role) &&
        normalizedStatus(data) in ['active', 'locked', 'disabled'] &&
        normalizedSecondaryRoles(data) is list &&
        normalizedSecondaryRoles(data).size() <= 7 &&
        (!('preDevRole' in data) || data.preDevRole == null || isValidRole(data.preDevRole));
    }

    function hasVerifiedEmail() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        'email' in request.auth.token &&
        request.auth.token.email is string;
    }

    function isPrimaryAdminEmail() {
      return hasVerifiedEmail() && (
        request.auth.token.email.lower() == 'qledtv4g@gmail.com' ||
        request.auth.token.email.lower() == 'nguyenthithanhtruc10112018@gmail.com' ||
        request.auth.token.email.lower() == 'thienbaovoquang@gmail.com' ||
        request.auth.token.email.lower() == 'nguyenvandung14102010@gmail.com' ||
        request.auth.token.email.lower() == 'nguyenvandung19112010@gmail.com' ||
        request.auth.token.email.lower() == 'nguyenvandunga3k30@gmail.com' ||
        request.auth.token.email.lower() == 'lethihong1011958@gmail.com'
      );
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ===== Cached Identity & Multi-Tenant Helpers =====
    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserDocActive(uData) {
      return uData.get('status', 'active') == 'active' ||
        uData.get('status', 'active') == null ||
        uData.get('status', 'active') == '';
    }

    function isUserActive() {
      return isSignedIn() && (
        (userDocExists() && isUserDocActive(userDocData())) ||
        (!userDocExists() && isPrimaryAdminEmail())
      );
    }

    function hasRole(roleName) {
      return isSignedIn() && userDocExists() &&
        isUserDocActive(userDocData()) && (
          userDocData().get('role', 'student') == roleName ||
          (userDocData().get('secondaryRoles', []) is list &&
            userDocData().get('secondaryRoles', []).hasAny([roleName]))
        );
    }

    function hasAnyRole(roles) {
      return isSignedIn() && userDocExists() &&
        isUserDocActive(userDocData()) && (
          userDocData().get('role', 'student') in roles ||
          (userDocData().get('secondaryRoles', []) is list &&
            userDocData().get('secondaryRoles', []).hasAny(roles))
        );
    }

    function isAdmin() {
      return (isPrimaryAdminEmail() && (!userDocExists() || isUserDocActive(userDocData()))) ||
        hasRole('admin');
    }

    // Backend/Console-controlled Development Admin Mode flag (unmodifiable from browser/client SDKs).
    function isDevelopmentAdminMode() {
      return exists(/databases/$(database)/documents/appConfig/runtime)
        ? get(/databases/$(database)/documents/appConfig/runtime).data.get('DEVELOPMENT_ADMIN_MODE', true) == true
        : true;
    }

    function isPrincipal() {
      return hasRole('principal');
    }

    function isLeadership() {
      return isAdmin() || hasRole('principal');
    }

    function isTeacher() {
      return hasAnyRole(['homeroom_teacher', 'subject_teacher']);
    }

    function isHomeroomTeacher() {
      return hasRole('homeroom_teacher');
    }

    function isLibrarian() {
      return hasRole('librarian');
    }

    function isCounselor() {
      return hasRole('counselor');
    }

    function isFacilityStaff() {
      return hasRole('staff');
    }

    function isSchoolStaff() {
      return isAdmin() || hasAnyRole(['principal', 'homeroom_teacher', 'subject_teacher', 'librarian', 'counselor', 'staff']);
    }

    function isEducatorOrLeader() {
      return isAdmin() || hasAnyRole(['principal', 'homeroom_teacher', 'subject_teacher']);
    }

    function isLibrarianOrAdmin() {
      return isAdmin() || hasRole('librarian');
    }

    function isLibraryStaff() {
      return isAdmin() || hasAnyRole(['principal', 'librarian']);
    }

    function isOperationsStaff() {
      return isAdmin() || hasAnyRole(['principal', 'homeroom_teacher', 'subject_teacher', 'librarian', 'staff']);
    }

    function getUserSchoolId() {
      return userDocExists() &&
        userDocData().get('schoolId', '') is string &&
        userDocData().get('schoolId', '') != ''
        ? userDocData().get('schoolId', 'schoolhub_main')
        : 'schoolhub_main';
    }

    function isDefaultSchool() {
      return getUserSchoolId() == 'schoolhub_main';
    }

    function sameSchool(data) {
      return data == null || !('schoolId' in data) || data.schoolId == null || data.schoolId == '' || data.schoolId == getUserSchoolId();
    }

    function canListSchool() {
      return isDefaultSchool() || resource.data.schoolId == getUserSchoolId();
    }

    function incomingSameSchool() {
      return !('schoolId' in request.resource.data) || request.resource.data.schoolId == getUserSchoolId();
    }

    function expectedInviteId() {
      let rawId = 'INV_' + request.auth.token.email.lower().replace('[^a-z0-9._-]', '_');
      return rawId.size() > 128 ? rawId[0:128] : rawId;
    }

    function hasClaimableInvite() {
      let invPath = /databases/$(database)/documents/userInvites/$(expectedInviteId());
      return hasVerifiedEmail() &&
        exists(invPath) &&
        (get(invPath).data.get('claimedByUid', '') in ['', null, request.auth.uid]) &&
        get(invPath).data.get('emailLower', '') == request.auth.token.email.lower();
    }

    function claimableInviteData() {
      return get(/databases/$(database)/documents/userInvites/$(expectedInviteId())).data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Immutable runtime config (only readable by signed-in clients; never writable from browser SDKs)
    match /appConfig/{configId} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if false;
    }

    // Users collection (PII protected; role, secondaryRoles, schoolId & status locked from escalation)
    match /users/{userId} {
      allow get: if isUser(userId) || (isValidId(userId) && isSchoolStaff() && (resource == null || sameSchool(resource.data)));
      allow list: if isSchoolStaff() && canListSchool();
      allow create: if isValidId(userId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidUserPayload(request.resource.data, userId) && (
          isAdmin() ||
          (isUser(userId) && isPrimaryAdminEmail() &&
            request.resource.data.role == 'admin' &&
            normalizedStatus(request.resource.data) == 'active') ||
          (isUser(userId) && hasVerifiedEmail() && isDevelopmentAdminMode() &&
            request.resource.data.role == 'admin' &&
            normalizedStatus(request.resource.data) == 'active') ||
          (isUser(userId) && hasClaimableInvite() &&
            request.resource.data.role == claimableInviteData().role &&
            normalizedSchoolId(request.resource.data) == normalizedSchoolId(claimableInviteData()) &&
            normalizedStatus(request.resource.data) == normalizedStatus(claimableInviteData()) &&
            normalizedSecondaryRoles(request.resource.data) == normalizedSecondaryRoles(claimableInviteData())) ||
          (isUser(userId) &&
            request.resource.data.role == 'student' &&
            normalizedSecondaryRoles(request.resource.data).size() == 0 &&
            normalizedStatus(request.resource.data) == 'active')
        );
      allow update: if isValidId(userId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidUserPayload(request.resource.data, userId) && (
          isAdmin() ||
          (isUser(userId) && isPrimaryAdminEmail() &&
            request.resource.data.role == 'admin' &&
            normalizedStatus(request.resource.data) == 'active') ||
          (isUser(userId) && hasVerifiedEmail() && isDevelopmentAdminMode() &&
            request.resource.data.role == 'admin' &&
            normalizedStatus(request.resource.data) == 'active') ||
          (isUser(userId) && hasClaimableInvite() &&
            request.resource.data.role == claimableInviteData().role &&
            normalizedSchoolId(request.resource.data) == normalizedSchoolId(claimableInviteData()) &&
            normalizedStatus(request.resource.data) == normalizedStatus(claimableInviteData()) &&
            normalizedSecondaryRoles(request.resource.data) == normalizedSecondaryRoles(claimableInviteData())) ||
          (isUser(userId) && isUserActive() &&
            (isValidRole(resource.data.get('role', ''))
              ? request.resource.data.role == resource.data.role
              : request.resource.data.role == 'student') &&
            normalizedSchoolId(request.resource.data) == normalizedSchoolId(resource.data) &&
            normalizedSecondaryRoles(request.resource.data) == normalizedSecondaryRoles(resource.data) &&
            normalizedStatus(request.resource.data) == normalizedStatus(resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'avatarUrl', 'photoURL', 'phone', 'email',
              'schoolId', 'version', 'status', 'role', 'updatedAt', 'updatedBy', 'createdAt', 'createdBy'
            ]))
        );
      allow delete: if isValidId(userId) && isAdmin() && (resource == null || sameSchool(resource.data));
    }

    // Pre-provisioned account invites indexed by INV_<normalized_email>
    match /userInvites/{inviteId} {
      allow get: if isValidId(inviteId) && (
        (hasVerifiedEmail() && inviteId == expectedInviteId()) ||
        (isLeadership() && (resource == null || sameSchool(resource.data)))
      );
      allow list: if isLeadership() && canListSchool();
      allow create: if isValidId(inviteId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.email, 3, 200) &&
        isValidString(request.resource.data.emailLower, 3, 200) &&
        isValidString(request.resource.data.displayName, 1, 100) &&
        isValidRole(request.resource.data.role) &&
        request.resource.data.status in ['active', 'locked', 'disabled'] &&
        normalizedSecondaryRoles(request.resource.data) is list &&
        normalizedSecondaryRoles(request.resource.data).size() <= 7 &&
        isAdmin() && incomingSameSchool();
      allow update: if isValidId(inviteId) && hasValidBaseMetadata(request.resource.data) && (
        (isValidString(request.resource.data.email, 3, 200) &&
          isValidString(request.resource.data.displayName, 1, 100) &&
          isValidRole(request.resource.data.role) &&
          normalizedSecondaryRoles(request.resource.data) is list &&
          normalizedSecondaryRoles(request.resource.data).size() <= 7 &&
          isAdmin() && incomingSameSchool()) ||
        (hasVerifiedEmail() &&
          inviteId == expectedInviteId() &&
          resource.data.get('emailLower', '') == request.auth.token.email.lower() &&
          (resource.data.get('claimedByUid', '') == '' || resource.data.get('claimedByUid', null) == null) &&
          request.resource.data.claimedByUid == request.auth.uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.emailLower == resource.data.emailLower &&
          normalizedSchoolId(request.resource.data) == normalizedSchoolId(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedByUid', 'claimedAt', 'updatedAt', 'updatedBy']))
      );
      allow delete: if isValidId(inviteId) && isAdmin() && (resource == null || sameSchool(resource.data));
    }

    // Shared cloud reference datasets for Analytics & AI
    match /externalDatasets/{datasetId} {
      allow get: if isValidId(datasetId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(datasetId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.get('name', request.resource.data.get('title', '')), 1, 200) &&
        isOperationsStaff() &&
        incomingSameSchool();
      allow delete: if isValidId(datasetId) && isLeadership() && (resource == null || sameSchool(resource.data));
    }

    // Student Profiles
    match /studentProfiles/{studentId} {
      allow get: if isValidId(studentId) && isUserActive() && (resource == null || sameSchool(resource.data)) && (
        studentId == request.auth.uid || (resource != null && resource.data.id == request.auth.uid) ||
        isAdmin() || hasAnyRole(['principal', 'homeroom_teacher', 'subject_teacher', 'librarian', 'counselor'])
      );
      allow list: if isUserActive() && canListSchool() && (
        resource.data.id == request.auth.uid ||
        isAdmin() || hasAnyRole(['principal', 'homeroom_teacher', 'subject_teacher', 'librarian', 'counselor'])
      );
      allow create, update: if isValidId(studentId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.studentCode, 2, 32) &&
        isValidString(request.resource.data.fullName, 1, 100) &&
        (isAdmin() || hasAnyRole(['principal', 'homeroom_teacher'])) &&
        incomingSameSchool();
      allow delete: if isValidId(studentId) && isAdmin() && (resource == null || sameSchool(resource.data));
    }

    // Teacher & Staff Profiles (teacherCode removed; identified by id/fullName/email)
    match /teacherProfiles/{teacherId} {
      allow get: if isValidId(teacherId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(teacherId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.fullName, 1, 100) &&
        isLeadership() && incomingSameSchool();
      allow delete: if isValidId(teacherId) && isAdmin() && (resource == null || sameSchool(resource.data));
    }

    match /staffMembers/{staffId} {
      allow get: if isValidId(staffId) && isSchoolStaff() && (resource == null || sameSchool(resource.data));
      allow list: if isSchoolStaff() && canListSchool();
      allow create, update: if isValidId(staffId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.fullName, 1, 100) &&
        isLeadership() && incomingSameSchool();
      allow delete: if isValidId(staffId) && isAdmin() && (resource == null || sameSchool(resource.data));
    }

    match /academicYears/{yearId} {
      allow get: if isValidId(yearId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(yearId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.name, 2, 64) &&
        isLeadership() && incomingSameSchool();
      allow delete: if isValidId(yearId) && isLeadership() && (resource == null || sameSchool(resource.data));
    }

    match /classes/{classId} {
      allow get: if isValidId(classId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(classId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.code, 1, 32) &&
        isValidString(request.resource.data.name, 1, 100) &&
        isLeadership() && incomingSameSchool();
      allow delete: if isValidId(classId) && isAdmin() && (resource == null || sameSchool(resource.data));
    }

    match /timetable/{entryId} {
      allow get: if isValidId(entryId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(entryId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidNumberRange(request.resource.data.dayOfWeek, 2, 7) &&
        isValidNumberRange(request.resource.data.period, 1, 10) &&
        isValidString(request.resource.data.subject, 1, 100) &&
        isLeadership() && incomingSameSchool();
      allow delete: if isValidId(entryId) && isLeadership() && (resource == null || sameSchool(resource.data));
    }

    match /assignments/{assignmentId} {
      allow get: if isValidId(assignmentId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(assignmentId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.title, 1, 200) &&
        isEducatorOrLeader() && incomingSameSchool();
      allow delete: if isValidId(assignmentId) && isEducatorOrLeader() && (resource == null || sameSchool(resource.data));
    }

    match /assignmentSubmissions/{submissionId} {
      allow get: if isValidId(submissionId) && isUserActive() && (resource == null || sameSchool(resource.data)) && (
        (resource != null && resource.data.studentId == request.auth.uid) ||
        isEducatorOrLeader()
      );
      allow list: if isUserActive() && canListSchool() && (
        resource.data.studentId == request.auth.uid ||
        isEducatorOrLeader()
      );
      allow create: if isValidId(submissionId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.content, 1, 4000) &&
        isUserActive() &&
        request.resource.data.studentId == request.auth.uid &&
        incomingSameSchool();
      allow update: if isValidId(submissionId) &&
        hasValidBaseMetadata(request.resource.data) &&
        request.resource.data.studentId == resource.data.studentId &&
        isEducatorOrLeader() && incomingSameSchool();
      allow delete: if isValidId(submissionId) && isAdmin() && (resource == null || sameSchool(resource.data));
    }

    match /learningMaterials/{materialId} {
      allow get: if isValidId(materialId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(materialId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.title, 1, 200) &&
        isEducatorOrLeader() && incomingSameSchool();
      allow delete: if isValidId(materialId) && isEducatorOrLeader() && (resource == null || sameSchool(resource.data));
    }

    // Library catalog, physical copies, transactions, reservations, renewals, history & audits
    match /books/{bookId} {
      allow get: if isValidId(bookId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(bookId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.title, 1, 200) &&
        isValidNumberRange(request.resource.data.totalCopies, 0, 10000) &&
        isValidNumberRange(request.resource.data.availableCopies, 0, 10000) &&
        isLibrarianOrAdmin() && incomingSameSchool();
      allow delete: if isValidId(bookId) && isLibrarianOrAdmin() && (resource == null || sameSchool(resource.data));
    }

    match /bookCopies/{copyId} {
      allow get: if isValidId(copyId) && isUserActive() && (resource == null || sameSchool(resource.data));
      allow list: if isUserActive() && canListSchool();
      allow create, update: if isValidId(copyId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.bookId, 1, 128) &&
        isValidString(request.resource.data.copyBarcode, 1, 64) &&
        isLibrarianOrAdmin() && incomingSameSchool();
      allow delete: if isValidId(copyId) && isLibrarianOrAdmin() && (resource == null || sameSchool(resource.data));
    }

    match /borrowTransactions/{transactionId} {
      allow get: if isValidId(transactionId) && isUserActive() && (resource == null || sameSchool(resource.data)) && (
        (resource != null && resource.data.studentId == request.auth.uid) ||
        isLibraryStaff()
      );
      allow list: if isUserActive() && canListSchool() && (
        resource.data.studentId == request.auth.uid ||
        isLibraryStaff()
      );
      allow create: if isValidId(transactionId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.studentId, 1, 128) &&
        isValidString(request.resource.data.bookId, 1, 128) &&
        request.resource.data.status in ['borrowed', 'returned', 'overdue', 'lost'] &&
        isLibrarianOrAdmin() && incomingSameSchool();
      allow update: if isValidId(transactionId) &&
        hasValidBaseMetadata(request.resource.data) &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.bookId == resource.data.bookId &&
        request.resource.data.status in ['borrowed', 'returned', 'overdue', 'lost'] &&
        isLibrarianOrAdmin() && incomingSameSchool();
      allow delete: if isValidId(transactionId) && isAdmin() && (resource == null || sameSchool(resource.data));
    }

    match /bookReservations/{reservationId} {
      allow get: if isValidId(reservationId) && isUserActive() && (resource == null || sameSchool(resource.data)) && (
        (resource != null && resource.data.studentId == request.auth.uid) ||
        isLibraryStaff()
      );
      allow list: if isUserActive() && canListSchool() && (
        resource.data.studentId == request.auth.uid ||
        isLibraryStaff()
      );
      allow create: if isValidId(reservationId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.bookId, 1, 128) &&
        isValidString(request.resource.data.studentId, 1, 128) &&
        request.resource.data.status in ['pending', 'ready', 'fulfilled', 'cancelled', 'expired'] &&
        isUserActive() && incomingSameSchool() && (
          isLibrarianOrAdmin() ||
          (request.resource.data.studentId == request.auth.uid && request.resource.data.status == 'pending')
        );
      allow update: if isValidId(reservationId) &&
        hasValidBaseMetadata(request.resource.data) &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.bookId == resource.data.bookId &&
        request.resource.data.status in ['pending', 'ready', 'fulfilled', 'cancelled', 'expired'] &&
        isUserActive() && incomingSameSchool() && (
          isLibrarianOrAdmin() ||
          (resource.data.studentId == request.auth.uid && request.resource.data.status == 'cancelled')
        );
      allow delete: if isValidId(reservationId) && isLibrarianOrAdmin() && (resource == null || sameSchool(resource.data));
    }

    match /libraryRenewalRequests/{requestId} {
      allow get: if isValidId(requestId) && isUserActive() && (resource == null || sameSchool(resource.data)) && (
        (resource != null && resource.data.borrowerId == request.auth.uid) ||
        isLibraryStaff()
      );
      allow list: if isUserActive() && canListSchool() && (
        resource.data.borrowerId == request.auth.uid ||
        isLibraryStaff()
      );
      allow create: if isValidId(requestId) &&
        hasValidBaseMetadata(request.resource.data) &&
        isValidString(request.resource.data.transactionId, 1, 128) &&
        isValidString(request.resource.data.reason, 2, 1000) &&
        request.resource.data.status == 'pending' &&
        isUserActive() && incomingSameSchool() &&
        (isLibrarianOrAdmin() || request.resource.data.borrowerId == request.auth.uid);
      allow update: if isValidId(requestId) &&
        hasValidBaseMetadata(request.resource.data) &&
        request.resource.data.borrowerId == resource.data.borrowerId &&
        request.resource.data.transactionId == resource.data.transactionId &&
        request.resource.data.status in ['pending', 'approved', 'rejected'] &&
        isLibrarianOrAdmin() && incomingSameSchool();
